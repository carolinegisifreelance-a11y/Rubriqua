# Rubriqua, réglages du serveur (Apache)

ErrorDocument 404 /404.html
Options -Indexes
DirectoryIndex index.html index.php

# Les règles de réécriture de WordPress ne s'appliquent pas au nouveau site
<IfModule mod_rewrite.c>
  RewriteEngine Off
</IfModule>

# Anciennes adresses des articles (slugs conservés par WordPress), redirigées en 301
RedirectMatch 301 ^/how-to-run-a-technical-seo-audit-on-your-site/?$ /blog/comment-faire-un-audit-seo/
RedirectMatch 301 ^/seo-and-google-ads-making-both-channels-work-together/?$ /blog/google-ads-ia-ai-max/
RedirectMatch 301 ^/which-web-analytics-metrics-should-you-track/?$ /blog/suivre-leads-cycle-vente-long-ga4-gtm/
RedirectMatch 301 ^/microsoft-decision-1-ce-que-le-nouveau-modele-de-microsoft-change-pour-bing-et-copilot/?$ /blog/microsoft-decision-1-change-pour-bing-et-copilot/
# Articles déplacés sous /blog/ le 10 novembre 2026
RedirectMatch 301 ^/(actualite-seo-ia-fin-octobre-2026|etre-recommande-chatgpt-industrie|referencement-fabricant-industriel|faille-php2shell-securite-referencement|comment-suivre-sa-visibilite-apercus-ia-google|microsoft-decision-1-change-pour-bing-et-copilot|suivre-leads-cycle-vente-long-ga4-gtm|google-ads-ia-ai-max|comment-faire-un-audit-seo)/?$ /blog/$1/
# Catégories du blog en français
RedirectMatch 301 ^/category/(.*)$ /categorie/$1
# Pages WordPress qui n'existent plus
RedirectMatch 301 ^/feed/?$ /blog/
RedirectMatch 301 ^/comments/feed/?$ /blog/
RedirectMatch 301 ^/blog/page/[0-9]+/?$ /blog/
RedirectMatch 301 ^/author/.*$ /a-propos/
RedirectMatch 301 ^/(wp-login\.php|wp-admin/?.*)$ /
RedirectMatch 404 ^/(xmlrpc\.php|wp-cron\.php|wp-config\.php|readme\.html|license\.txt)$

# Cache des fichiers statiques
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Les pages HTML sont toujours revérifiées, pour que chaque mise à jour s'affiche tout de suite
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Sécurité de base
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Le dossier des maquettes de travail n'est pas public
RedirectMatch 404 ^/maquettes/.*$
RedirectMatch 404 ^/docs/.*$
RedirectMatch 404 ^/README\.md$
